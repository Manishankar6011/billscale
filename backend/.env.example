# ==============================================================================
# BuildMate ERP - Multi-Tenant Labor ERP Credentials Template
# ==============================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. Database (MongoDB)
# If using MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/buildmate-erp
# If using Local MongoDB: mongodb://localhost:27017/buildmate-erp
MONGO_URI=mongodb://localhost:27017/buildmate-erp

# 3. Security (JWT)
# Use a strong, random string for production
JWT_SECRET=b4ck3nd_53cr3t_k3y_f0r_jwt_v4l1d4t1on

# 4. Optional: Subscription & Payments (Razorpay)
# Future Phase - Add your Razorpay API keys here
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# 5. Email Configuration (Gmail)
# Use a Gmail App Password, NOT your regular password.
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=your-email@gmail.com

# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env'
# 2. Update the MONGO_URI and JWT_SECRET with your own values.
# 3. For Email: Enable 2-Step Verification on Gmail and generate an "App Password".
# 4. Ensure the backend and frontend are in communication during deployment.
# ==============================================================================
GEMINI_API_KEY=
GROQ_API_KEY=
AI_PROVIDER=groq
